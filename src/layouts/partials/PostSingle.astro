---
import config from "@/config/config.json";
import Share from "@/components/Share.astro";
import SimilarPosts from "@/components/SimilarPosts.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import similerItems from "@/lib/utils/similarItems";
import { humanize, markdownify, slugify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";
import { render } from "astro:content";
import { BiCalendarEdit, BiCategoryAlt } from "react-icons/bi";

const allAuthors = await getSinglePage("authors");
const posts = await getSinglePage("posts");
const { post } = Astro.props;
const similarPosts = similerItems(post, posts, post.id);
const { Content, headings } = await render(post);
const { title, description, authors, categories, image, date, tags } =
  post.data;

// Get TOC configuration from frontmatter or use defaults
const tocMinDepth = post.data.tocMinDepth || 2;
const tocMaxDepth = post.data.tocMaxDepth || 4;

// Generate URLs for structured data
const siteUrl = config.site.base_url;
const basePath = config.site.base_path || "/";
const baseUrl = new URL(
  basePath.endsWith("/") ? basePath : `${basePath}/`,
  siteUrl,
);
const siteBase = baseUrl.href.replace(/\/$/, "");
const toBasePathUrl = (path = "") =>
  path
    ? new URL(path.startsWith("/") ? path.slice(1) : path, baseUrl).toString()
    : siteBase;
const resolveAssetUrl = (assetPath: string | undefined) => {
  if (!assetPath) {
    return toBasePathUrl(config.metadata.meta_image);
  }
  return /^https?:\/\//i.test(assetPath)
    ? assetPath
    : toBasePathUrl(assetPath);
};
const postUrl = toBasePathUrl(post.id);
const imageUrl = resolveAssetUrl(image);
const logoUrl = resolveAssetUrl(config.site.logo);

// Get post authors for structured data
const postAuthors = allAuthors.filter((author) =>
  authors
    .map((author: string) => slugify(author))
    .includes(slugify(author.data.title)),
);

// Generate structured data
const keywords = tags && tags.length ? tags.join(", ") : undefined;
const websiteId = new URL("#website", baseUrl).toString();
const organizationId = new URL("#organization", baseUrl).toString();
const logoId = new URL("#logo", baseUrl).toString();
const breadcrumbId = `${postUrl}#breadcrumb`;
const primaryImageId = `${postUrl}#primaryimage`;
const articleId = `${postUrl}#article`;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: siteBase,
      name: config.site.title,
      description: config.metadata.meta_description,
      publisher: { "@id": organizationId },
      inLanguage: "en",
    },
    {
      "@type": "Organization",
      "@id": organizationId,
      name: config.site.title,
      url: siteBase,
      logo: {
        "@type": "ImageObject",
        "@id": logoId,
        url: logoUrl,
        contentUrl: logoUrl,
      },
      image: { "@id": logoId },
    },
    {
      "@type": "WebPage",
      "@id": postUrl,
      url: postUrl,
      name: title,
      isPartOf: { "@id": websiteId },
      primaryImageOfPage: { "@id": primaryImageId },
      breadcrumb: { "@id": breadcrumbId },
      inLanguage: "en",
      datePublished: new Date(date).toISOString(),
      dateModified: post.data.lastmod
        ? new Date(post.data.lastmod).toISOString()
        : new Date(date).toISOString(),
      description: description,
    },
    {
      "@type": "BreadcrumbList",
      "@id": breadcrumbId,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: siteBase,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Articles",
          item: siteBase,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: title,
          item: postUrl,
        },
      ],
    },
    {
      "@type": "Article",
      "@id": articleId,
      url: postUrl,
      isPartOf: { "@id": postUrl },
      mainEntityOfPage: { "@id": postUrl },
      headline: title,
      description: description,
      datePublished: new Date(date).toISOString(),
      dateModified: post.data.lastmod
        ? new Date(post.data.lastmod).toISOString()
        : new Date(date).toISOString(),
      inLanguage: "en",
      author:
        postAuthors.length === 1
          ? {
              "@type": "Person",
              name: postAuthors[0].data.title,
              url: toBasePathUrl(`authors/${slugify(postAuthors[0].id)}`),
            }
          : postAuthors.map((author) => ({
              "@type": "Person",
              name: author.data.title,
              url: toBasePathUrl(`authors/${slugify(author.id)}`),
            })),
      publisher: { "@id": organizationId },
      image: [{ "@id": primaryImageId }],
      thumbnailUrl: imageUrl,
      articleSection: categories.length > 0 ? categories[0] : "",
      keywords,
    },
    {
      "@type": "ImageObject",
      "@id": primaryImageId,
      url: imageUrl,
      contentUrl: imageUrl,
    },
  ],
};
const structuredDataString = JSON.stringify(structuredData).replace(
  /</g,
  "\\u003c",
);
---

<!-- Structured Data -->
<head>
  <script
    type="application/ld+json"
    set:html={structuredDataString}
  />
</head>

<section class="section">
  <div class="container">
    <!-- Header Section -->
    <article class="row justify-center">
      <div class="md:col-10 text-center">
        <h1 set:html={markdownify(title)} class="h2" />
        <ul class="mt-4 flex flex-wrap items-center justify-center text-text">
          <li class="mx-3">
            {
              allAuthors
                .filter((author) =>
                  authors
                    .map((author: string) => slugify(author))
                    .includes(slugify(author.data.title)),
                )
                 .map((author) => (
                   <a
                     href={`${basePath}authors/${slugify(author.id)}`}
                     class="flex items-center hover:text-primary font-medium"
                   >
                    {author.data.image && (
                      <Image
                        src={author.data.image}
                        alt={author.data.title}
                        height={50}
                        width={50}
                        class="mr-2 h-6 w-6 rounded-full"
                      />
                    )}
                    <span>{author.data.title}</span>
                  </a>
                ))
            }
          </li>
          <li class="mx-3 flex items-center flex-wrap font-medium">
            <BiCalendarEdit className="mr-1 h-5 w-5 text-gray-600" />
            {dateFormat(date)}
          </li>
          <li class="mx-3 flex items-center flex-wrap">
            <BiCategoryAlt className="mr-1 h-[18px] w-[18px] text-gray-600" />

            <ul>
              {
                categories.map((category: string, i: number) => (
                  <li class="inline-block">
                     <a
                       href={`${basePath}categories/${slugify(category)}`}
                       class="mr-2 hover:text-primary font-medium"
                     >
                      {humanize(category)}
                      {i !== post.data.categories.length - 1 && ","}
                    </a>
                  </li>
                ))
              }
            </ul>
          </li>
        </ul>
      </div>

      <div class="col-12 mt-8 mb-2">
        {
          image && (
            <Image
              src={image}
              height={500}
              width={1000}
              alt={title}
              class="rounded-lg"
            />
          )
        }
      </div>
    </article>

    <!-- Mobile TOC -->
    <div class="block lg:hidden mb-8">
      <TableOfContents
        headings={headings}
        minDepth={tocMinDepth}
        maxDepth={tocMaxDepth}
      />
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Desktop TOC Sidebar -->
      <aside class="hidden lg:block lg:col-span-3">
        <TableOfContents
          headings={headings}
          minDepth={tocMinDepth}
          maxDepth={tocMaxDepth}
        />
      </aside>

      <!-- Main Article Content -->
      <article class="lg:col-span-8">
        <div class="content mb-16 text-left prose prose-lg max-w-none">
          <Content />
        </div>

        <!-- Tags and Share -->
        <div class="flex flex-wrap items-center justify-between border-t pt-8">
          <ul class="mr-4 mb-4 space-x-3">
            {
              tags.map((tag: string) => (
                <li class="inline-block">
                   <a
                     href={`${basePath}tags/${slugify(tag)}`}
                     class="block rounded-lg bg-light px-4 py-2 font-semibold text-dark text-sm hover:text-primary transition duration-300"
                   >
                    #{humanize(tag)}
                  </a>
                </li>
              ))
            }
          </ul>
          <Share
            className="social-share mb-4"
            title={title}
            description={description}
            slug={post.id}
          />
        </div>
      </article>

      <!-- Right Spacer for Desktop Balance -->
      <div class="hidden lg:block lg:col-span-1"></div>
    </div>
  </div>
</section>

<!-- similar posts -->
{
  similarPosts.length > 0 && (
    <section class="section pt-0">
      <div class="container">
        <h2 class="mb-8 text-center h3">Similar Posts</h2>
        <SimilarPosts posts={similarPosts.slice(0, 3)} />
      </div>
    </section>
  )
}
