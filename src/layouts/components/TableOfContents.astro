---
export interface Props {
  headings: Array<{
    depth: number;
    slug: string;
    text: string;
  }>;
  title?: string;
  minDepth?: number;
  maxDepth?: number;
}

const {
  headings,
  title = "Table of Contents",
  minDepth = 2,
  maxDepth = 4,
} = Astro.props;

// Filter headings by depth range
const filteredHeadings = headings.filter(
  (heading) => heading.depth >= minDepth && heading.depth <= maxDepth,
);

// Build nested tree structure
interface TreeNode {
  heading: (typeof filteredHeadings)[0];
  children: TreeNode[];
}

function buildTree(headings: typeof filteredHeadings): TreeNode[] {
  const tree: TreeNode[] = [];
  const stack: TreeNode[] = [];

  for (const heading of headings) {
    const node: TreeNode = { heading, children: [] };

    // Find the appropriate parent level
    while (
      stack.length > 0 &&
      stack[stack.length - 1].heading.depth >= heading.depth
    ) {
      stack.pop();
    }

    if (stack.length === 0) {
      tree.push(node);
    } else {
      stack[stack.length - 1].children.push(node);
    }

    stack.push(node);
  }

  return tree;
}

const tocTree = buildTree(filteredHeadings);
---

{
  filteredHeadings.length > 0 && (
    <nav
      aria-label="Table of contents"
      class="
        max-h-[70vh] overflow-y-auto p-4
        bg-light border border-border rounded-lg
        sticky top-8
        shadow-sm hover:shadow-md
        transition-shadow duration-300 ease-out
        animate-fade-in-up
        md:static md:mb-8 md:max-h-none
        motion-reduce:animate-none motion-reduce:transition-none
        scrollbar-thin scrollbar-thumb-border scrollbar-track-light
      "
    >
      <h3
        class="
        text-lg font-semibold text-text-dark
        mb-3 pb-2
        border-b border-border
        tracking-tight leading-tight
        md:text-base md:mb-2
      "
      >
        {title}
      </h3>

      <ul class="list-none p-0 m-0 space-y-1">
        {tocTree.map((node) => (
          <li>
            <a
              href={`#${node.heading.slug}`}
              class="
                block text-sm text-text no-underline
                py-1 rounded
                break-words hyphens-auto
                transition-colors duration-200 ease-out
                hover:text-primary hover:underline hover:bg-primary hover:bg-opacity-5 hover:pl-2
                focus:outline-2 focus:outline-primary focus:outline-offset-2
                motion-reduce:transition-none
                toc-link
              "
            >
              {node.heading.text}
            </a>
            {node.children.length > 0 && (
              <ul class="list-none p-0 m-0 ml-4 mt-1 space-y-1 md:ml-3">
                {node.children.map((child) => (
                  <li>
                    <a
                      href={`#${child.heading.slug}`}
                      class="
                        block text-xs text-text no-underline
                        py-1 rounded
                        break-words hyphens-auto
                        opacity-90 border-l-2 border-transparent pl-2 -ml-2
                        transition-colors duration-200 ease-out
                        hover:text-primary hover:underline hover:bg-primary hover:bg-opacity-5 hover:border-l-primary hover:opacity-100
                        focus:outline-2 focus:outline-primary focus:outline-offset-2
                        motion-reduce:transition-none
                        toc-sublink
                      "
                    >
                      {child.heading.text}
                    </a>
                    {child.children.length > 0 && (
                      <ul class="list-none p-0 m-0 ml-4 mt-1 space-y-1 md:ml-3">
                        {child.children.map((grandchild) => (
                          <li>
                            <a
                              href={`#${grandchild.heading.slug}`}
                              class="
                                block text-xs text-text no-underline
                                py-1 rounded font-normal
                                break-words hyphens-auto
                                opacity-80 border-l-2 border-transparent pl-2 -ml-2
                                transition-colors duration-200 ease-out
                                hover:text-primary hover:underline hover:bg-primary hover:bg-opacity-5 hover:border-l-primary hover:opacity-100
                                focus:outline-2 focus:outline-primary focus:outline-offset-2
                                motion-reduce:transition-none
                                toc-sublink
                              "
                            >
                              {grandchild.heading.text}
                            </a>
                            {grandchild.children.length > 0 && (
                              <ul class="list-none p-0 m-0 ml-4 mt-1 space-y-1 md:ml-3">
                                {grandchild.children.map((greatgrandchild) => (
                                  <li>
                                    <a
                                      href={`#${greatgrandchild.heading.slug}`}
                                      class="
                                        block text-xs text-text no-underline
                                        py-1 rounded font-normal italic
                                        break-words hyphens-auto
                                        opacity-70 border-l-2 border-transparent pl-2 -ml-2
                                        transition-colors duration-200 ease-out
                                        hover:text-primary hover:underline hover:bg-primary hover:bg-opacity-5 hover:border-l-primary hover:opacity-100
                                        focus:outline-2 focus:outline-primary focus:outline-offset-2
                                        motion-reduce:transition-none
                                        toc-sublink
                                      "
                                    >
                                      {greatgrandchild.heading.text}
                                    </a>
                                  </li>
                                ))}
                              </ul>
                            )}
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  /* Global styles that can't be easily done with Tailwind */
  :global(html) {
    scroll-behavior: smooth;
  }

  /* Style for anchor links added by rehype-autolink-headings */
  :global(.anchor-link) {
    text-decoration: none;
    color: inherit;
  }

  :global(.anchor-link:hover) {
    text-decoration: none;
  }

  /* Custom animation for fade in up effect */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.4s ease-out;
  }

  /* Enhanced hover effects for TOC links */
  .toc-link:hover {
    transform: translateX(2px);
    background-color: rgba(1, 173, 159, 0.08);
  }

  .toc-sublink:hover {
    transform: translateX(2px);
    background-color: rgba(1, 173, 159, 0.05);
  }

  .toc-link:active,
  .toc-sublink:active {
    transform: translateX(1px);
    background-color: rgba(1, 173, 159, 0.12);
  }

  .toc-link:focus,
  .toc-sublink:focus {
    background-color: rgba(1, 173, 159, 0.1);
  }

  /* Custom scrollbar */
  .scrollbar-thin::-webkit-scrollbar {
    width: 6px;
  }

  .scrollbar-track-light::-webkit-scrollbar-track {
    background: var(--color-light, #fafafa);
    border-radius: 3px;
  }

  .scrollbar-thumb-border::-webkit-scrollbar-thumb {
    background: var(--color-border, #d5d5d5);
    border-radius: 3px;
  }

  nav:hover .scrollbar-thumb-border::-webkit-scrollbar-thumb {
    background: var(--color-text, #747577);
  }

  /* Print styles */
  @media print {
    nav[aria-label="Table of contents"] {
      border: 1px solid #ccc !important;
      background: white !important;
      box-shadow: none !important;
      page-break-inside: avoid;
      margin-bottom: 1rem;
    }

    .toc-link:after,
    .toc-sublink:after {
      content: " (see page content)";
      font-size: 0.75rem;
      color: #666;
    }

    .toc-link,
    .toc-sublink {
      color: #000 !important;
      text-decoration: none;
    }
  }

  /* High contrast mode support */
  @media (prefers-contrast: high) {
    nav[aria-label="Table of contents"] {
      border: 2px solid;
      background: Canvas;
      color: CanvasText;
    }

    .toc-link,
    .toc-sublink {
      color: LinkText;
    }

    .toc-link:hover,
    .toc-link:focus,
    .toc-sublink:hover,
    .toc-sublink:focus {
      background: Highlight;
      color: HighlightText;
    }
  }

  /* Reduced motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .animate-fade-in-up {
      animation: none;
    }

    .toc-link,
    .toc-sublink {
      transition: none;
      transform: none;
    }

    .toc-link:hover,
    .toc-link:active,
    .toc-sublink:hover,
    .toc-sublink:active {
      transform: none;
    }
  }

  /* Dark mode support */
  @media (prefers-color-scheme: dark) {
    nav[aria-label="Table of contents"] {
      background: #1a1a1a;
      border-color: #333;
      color: #e5e5e5;
    }

    h3 {
      color: #f5f5f5;
      border-bottom-color: #333;
    }

    .toc-link,
    .toc-sublink {
      color: #b3b3b3;
    }

    .toc-link:hover,
    .toc-sublink:hover {
      color: #01d4c4;
      background-color: rgba(1, 173, 159, 0.1);
    }

    .scrollbar-track-light::-webkit-scrollbar-track {
      background: #2a2a2a;
    }

    .scrollbar-thumb-border::-webkit-scrollbar-thumb {
      background: #555;
    }
  }
</style>
