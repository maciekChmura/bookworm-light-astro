---
import { Image } from "astro:assets";
import config from "@/config/config.json";
const { src } = Astro.props;
const {
  logo,
  logo_width,
  logo_height,
  logo_text,
  title,
  base_path,
}: {
  logo: string;
  logo_width: any;
  logo_height: any;
  logo_text: string;
  title: string;
  base_path: string;
} = config.site;

const basePathConfig = base_path || "/";
const basePath = basePathConfig.endsWith("/")
  ? basePathConfig
  : `${basePathConfig}/`;
---

<a href={basePath} class="navbar-brand block">
  {
    src ? (
      <Image
        width={logo_width.replace("px", "") * 2}
        height={logo_height.replace("px", "") * 2}
        src={src}
        alt={title}
        style={{
          height: logo_height.replace("px", "") + "px",
          width: logo_width.replace("px", "") + "px",
        }}
      />
    ) : logo ? (
      <img
        width={logo_width.replace("px", "")}
        height={logo_height.replace("px", "")}
        src={logo}
        alt={title}
        style={{
          height: logo_height.replace("px", "") + "px",
          width: logo_width.replace("px", "") + "px",
        }}
      />
    ) : logo_text ? (
      logo_text
    ) : (
      title
    )
  }
</a>
