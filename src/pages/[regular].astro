---
import Base from "@/layouts/Base.astro";
import PostSingle from "@/layouts/partials/PostSingle.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { render } from "astro:content";

type PageEntry = Awaited<ReturnType<typeof getSinglePage>>[number];

export async function getStaticPaths() {
  const [pages, posts] = await Promise.all([
    getSinglePage("pages"),
    getSinglePage("posts"),
  ]);

  return [
    ...pages.map((entry) => ({
      params: { regular: entry.slug },
      props: { entry, type: "page" as const },
    })),
    ...posts.map((entry) => ({
      params: { regular: entry.id },
      props: { entry, type: "post" as const },
    })),
  ];
}

const { entry, type }: { entry: PageEntry; type: "page" | "post" } =
  Astro.props;

let Content: Awaited<ReturnType<typeof render>>["Content"] | null = null;

if (type === "page") {
  ({ Content } = await render(entry));
}

const { title, meta_title, description, image } = entry.data;
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  {
    type === "page" && Content ? (
      <section class="section">
        <div class="container">
          <h1 set:html={markdownify(title)} class="h2 page-heading" />
          <div class="content">
            <Content />
          </div>
        </div>
      </section>
    ) : (
      <PostSingle post={entry} />
    )
  }
</Base>
